rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthorizedWorkspace(ownerUid) {
      return ownerUid is string && ownerUid.size() >= 1 && ownerUid.size() <= 128 && (
        ownerUid == 'shindong_5_2_ws' ||
        (request.auth != null && request.auth.token.email_verified == true && ownerUid == request.auth.uid)
      );
    }

    function isStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    // Validation Blueprints
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'workspaceOwnerUid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'workspaceOwnerUid', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        isAuthorizedWorkspace(data.workspaceOwnerUid) &&
        data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll([
        'uid', 'workspaceOwnerUid', 'role', 'studentLoginId', 'passwordHash',
        'displayName', 'classId', 'avatarId', 'bio', 'interests', 'hobbies',
        'favoriteFood', 'strengths', 'cheerWanted', 'profileVisibility',
        'accountStatus', 'lastLoginAt', 'lastHeartbeatAt', 'isOnlineSession',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'workspaceOwnerUid', 'role', 'studentLoginId', 'passwordHash',
        'displayName', 'classId', 'avatarId', 'bio', 'interests', 'hobbies',
        'favoriteFood', 'strengths', 'cheerWanted', 'profileVisibility',
        'accountStatus', 'lastLoginAt', 'lastHeartbeatAt', 'isOnlineSession',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      data.role is string && (data.role == 'teacher' || data.role == 'student') &&
      data.studentLoginId is string && data.studentLoginId.size() >= 1 && data.studentLoginId.size() <= 64 &&
      data.passwordHash is string && data.passwordHash.size() >= 1 && data.passwordHash.size() <= 128 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      isValidId(data.classId) &&
      data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 40 &&
      data.bio is string && data.bio.size() <= 300 &&
      isStringList(data.interests, 10) &&
      isStringList(data.hobbies, 10) &&
      data.favoriteFood is string && data.favoriteFood.size() <= 120 &&
      data.strengths is string && data.strengths.size() <= 200 &&
      data.cheerWanted is string && data.cheerWanted.size() <= 200 &&
      data.profileVisibility is string && (data.profileVisibility == 'private' || data.profileVisibility == 'manitto' || data.profileVisibility == 'class') &&
      data.accountStatus is string && (data.accountStatus == 'active' || data.accountStatus == 'inactive') &&
      data.lastLoginAt is string && data.lastLoginAt.size() <= 40 &&
      data.lastHeartbeatAt is string && data.lastHeartbeatAt.size() <= 40 &&
      data.isOnlineSession is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidClassRoom(data) {
      return data.keys().hasAll(['classId', 'workspaceOwnerUid', 'name', 'schoolName', 'teacherUids', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['classId', 'workspaceOwnerUid', 'name', 'schoolName', 'teacherUids', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.classId) &&
        isAuthorizedWorkspace(data.workspaceOwnerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 80 &&
        isStringList(data.teacherUids, 10) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidManittoAssignment(data) {
      return data.keys().hasAll(['assignmentId', 'workspaceOwnerUid', 'classId', 'giverUid', 'receiverUid', 'active', 'startsAt', 'endsAt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['assignmentId', 'workspaceOwnerUid', 'classId', 'giverUid', 'receiverUid', 'active', 'startsAt', 'endsAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.assignmentId) &&
        isAuthorizedWorkspace(data.workspaceOwnerUid) &&
        isValidId(data.classId) &&
        isValidId(data.giverUid) &&
        isValidId(data.receiverUid) &&
        data.active is bool &&
        data.startsAt is string && data.startsAt.size() <= 40 &&
        data.endsAt is string && data.endsAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMission(data) {
      return data.keys().hasAll([
        'missionId', 'workspaceOwnerUid', 'orderIndex', 'title', 'description',
        'howTo', 'category', 'difficulty', 'points', 'active',
        'requiresTeacherApproval', 'allowRepeat', 'maxCompletions', 'badgeRuleType',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'missionId', 'workspaceOwnerUid', 'orderIndex', 'title', 'description',
        'howTo', 'category', 'difficulty', 'points', 'active',
        'requiresTeacherApproval', 'allowRepeat', 'maxCompletions', 'badgeRuleType',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.missionId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      data.orderIndex is number && data.orderIndex >= 1 && data.orderIndex <= 100 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 400 &&
      data.howTo is string && data.howTo.size() <= 400 &&
      data.category is string && data.category.size() <= 30 &&
      data.difficulty is string && (data.difficulty == 'easy' || data.difficulty == 'medium' || data.difficulty == 'hard') &&
      data.points is number && data.points >= 1 && data.points <= 100 &&
      data.active is bool &&
      data.requiresTeacherApproval is bool &&
      data.allowRepeat is bool &&
      data.maxCompletions is number && data.maxCompletions >= 1 && data.maxCompletions <= 50 &&
      data.badgeRuleType is string && data.badgeRuleType.size() <= 40 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMissionSubmission(data) {
      return data.keys().hasAll([
        'submissionId', 'workspaceOwnerUid', 'missionId', 'studentUid', 'classId',
        'actionDescription', 'reflection', 'activityDate', 'evidenceNote', 'status',
        'awardedPoints', 'reviewedBy', 'reviewedAt', 'reviewComment', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'submissionId', 'workspaceOwnerUid', 'missionId', 'studentUid', 'classId',
        'actionDescription', 'reflection', 'activityDate', 'evidenceNote', 'status',
        'awardedPoints', 'reviewedBy', 'reviewedAt', 'reviewComment', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.submissionId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.missionId) &&
      isValidId(data.studentUid) &&
      isValidId(data.classId) &&
      data.actionDescription is string && data.actionDescription.size() >= 1 && data.actionDescription.size() <= 500 &&
      data.reflection is string && data.reflection.size() >= 1 && data.reflection.size() <= 500 &&
      data.activityDate is string && data.activityDate.size() >= 8 && data.activityDate.size() <= 20 &&
      data.evidenceNote is string && data.evidenceNote.size() <= 200 &&
      data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected' || data.status == 'deleted') &&
      data.awardedPoints is number && data.awardedPoints >= 0 && data.awardedPoints <= 100 &&
      data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
      data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
      data.reviewComment is string && data.reviewComment.size() <= 200 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidScoreLedger(data) {
      return data.keys().hasAll([
        'ledgerId', 'workspaceOwnerUid', 'studentUid', 'classId', 'sourceType',
        'sourceId', 'pointsDelta', 'activityDate', 'reason', 'createdBy',
        'reversalOf', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ledgerId', 'workspaceOwnerUid', 'studentUid', 'classId', 'sourceType',
        'sourceId', 'pointsDelta', 'activityDate', 'reason', 'createdBy',
        'reversalOf', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.ledgerId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.studentUid) &&
      isValidId(data.classId) &&
      data.sourceType is string && (data.sourceType == 'mission' || data.sourceType == 'adjustment' || data.sourceType == 'reversal') &&
      data.sourceId is string && data.sourceId.size() <= 128 &&
      data.pointsDelta is number && data.pointsDelta >= -500 && data.pointsDelta <= 500 &&
      data.activityDate is string && data.activityDate.size() <= 20 &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 240 &&
      data.createdBy is string && data.createdBy.size() <= 128 &&
      data.reversalOf is string && data.reversalOf.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudentStats(data) {
      return data.keys().hasAll([
        'studentUid', 'workspaceOwnerUid', 'classId', 'totalPoints',
        'completedMissionCount', 'earnedBadgeCount', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentUid', 'workspaceOwnerUid', 'classId', 'totalPoints',
        'completedMissionCount', 'earnedBadgeCount', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.studentUid) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.classId) &&
      data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 10000 &&
      data.completedMissionCount is number && data.completedMissionCount >= 0 && data.completedMissionCount <= 500 &&
      data.earnedBadgeCount is number && data.earnedBadgeCount >= 0 && data.earnedBadgeCount <= 50 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBadge(data) {
      return data.keys().hasAll([
        'badgeId', 'workspaceOwnerUid', 'name', 'description', 'icon',
        'criteria', 'targetCount', 'active', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'badgeId', 'workspaceOwnerUid', 'name', 'description', 'icon',
        'criteria', 'targetCount', 'active', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.badgeId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
      data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 40 &&
      data.criteria is string && data.criteria.size() >= 1 && data.criteria.size() <= 200 &&
      data.targetCount is number && data.targetCount >= 1 && data.targetCount <= 100 &&
      data.active is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBadgeAward(data) {
      return data.keys().hasAll([
        'awardId', 'workspaceOwnerUid', 'studentUid', 'badgeId', 'classId',
        'awardedAt', 'criteriaSnapshot', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'awardId', 'workspaceOwnerUid', 'studentUid', 'badgeId', 'classId',
        'awardedAt', 'criteriaSnapshot', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.awardId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.studentUid) &&
      isValidId(data.badgeId) &&
      isValidId(data.classId) &&
      data.awardedAt is string && data.awardedAt.size() <= 40 &&
      data.criteriaSnapshot is string && data.criteriaSnapshot.size() <= 200 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLetterThread(data) {
      return data.keys().hasAll([
        'threadId', 'workspaceOwnerUid', 'classId', 'assignmentId',
        'participantUids', 'lastMessageAt', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'threadId', 'workspaceOwnerUid', 'classId', 'assignmentId',
        'participantUids', 'lastMessageAt', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.threadId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.classId) &&
      isValidId(data.assignmentId) &&
      isStringList(data.participantUids, 2) &&
      data.lastMessageAt is string && data.lastMessageAt.size() <= 40 &&
      data.status is string && (data.status == 'active' || data.status == 'archived') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLetter(data) {
      return data.keys().hasAll([
        'letterId', 'workspaceOwnerUid', 'threadId', 'classId', 'senderUid',
        'receiverUid', 'senderDirection', 'subject', 'body', 'readAt',
        'moderationStatus', 'deletedAt', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'letterId', 'workspaceOwnerUid', 'threadId', 'classId', 'senderUid',
        'receiverUid', 'senderDirection', 'subject', 'body', 'readAt',
        'moderationStatus', 'deletedAt', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.letterId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.threadId) &&
      isValidId(data.classId) &&
      isValidId(data.senderUid) &&
      isValidId(data.receiverUid) &&
      data.senderDirection is string && (data.senderDirection == 'from_manitto' || data.senderDirection == 'to_manitto') &&
      data.subject is string && data.subject.size() <= 120 &&
      data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
      data.readAt is string && data.readAt.size() <= 40 &&
      data.moderationStatus is string && (data.moderationStatus == 'normal' || data.moderationStatus == 'reported' || data.moderationStatus == 'hidden') &&
      data.deletedAt is string && data.deletedAt.size() <= 40 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLoungeSession(data) {
      return data.keys().hasAll([
        'sessionId', 'workspaceOwnerUid', 'classId', 'title', 'noticeRules',
        'scheduledDate', 'startsAt', 'endsAt', 'status', 'waitingCount',
        'participantCount', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId', 'workspaceOwnerUid', 'classId', 'title', 'noticeRules',
        'scheduledDate', 'startsAt', 'endsAt', 'status', 'waitingCount',
        'participantCount', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.sessionId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.classId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.noticeRules is string && data.noticeRules.size() <= 400 &&
      data.scheduledDate is string && data.scheduledDate.size() <= 20 &&
      data.startsAt is string && data.startsAt.size() <= 40 &&
      data.endsAt is string && data.endsAt.size() <= 40 &&
      data.status is string && (data.status == 'scheduled' || data.status == 'waiting' || data.status == 'active' || data.status == 'ended') &&
      data.waitingCount is number && data.waitingCount >= 0 && data.waitingCount <= 200 &&
      data.participantCount is number && data.participantCount >= 0 && data.participantCount <= 200 &&
      data.createdBy is string && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLoungeParticipant(data) {
      return data.keys().hasAll([
        'participantUid', 'workspaceOwnerUid', 'sessionId', 'anonymousAlias',
        'presenceStatus', 'aliasChangeCount', 'joinedAt', 'lastHeartbeatAt',
        'aliasChangedAt', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'participantUid', 'workspaceOwnerUid', 'sessionId', 'anonymousAlias',
        'presenceStatus', 'aliasChangeCount', 'joinedAt', 'lastHeartbeatAt',
        'aliasChangedAt', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.participantUid) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.sessionId) &&
      data.anonymousAlias is string && data.anonymousAlias.size() >= 1 && data.anonymousAlias.size() <= 40 &&
      data.presenceStatus is string && (data.presenceStatus == 'waiting' || data.presenceStatus == 'active' || data.presenceStatus == 'left') &&
      data.aliasChangeCount is number && data.aliasChangeCount >= 0 && data.aliasChangeCount <= 20 &&
      data.joinedAt is string && data.joinedAt.size() <= 40 &&
      data.lastHeartbeatAt is string && data.lastHeartbeatAt.size() <= 40 &&
      data.aliasChangedAt is string && data.aliasChangedAt.size() <= 40 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLoungeMessage(data) {
      return data.keys().hasAll([
        'messageId', 'workspaceOwnerUid', 'sessionId', 'classId', 'senderUid',
        'anonymousAlias', 'body', 'moderationStatus', 'hiddenAt', 'hiddenBy',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'messageId', 'workspaceOwnerUid', 'sessionId', 'classId', 'senderUid',
        'anonymousAlias', 'body', 'moderationStatus', 'hiddenAt', 'hiddenBy',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.messageId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.sessionId) &&
      isValidId(data.classId) &&
      isValidId(data.senderUid) &&
      data.anonymousAlias is string && data.anonymousAlias.size() >= 1 && data.anonymousAlias.size() <= 40 &&
      data.body is string && data.body.size() >= 1 && data.body.size() <= 400 &&
      data.moderationStatus is string && (data.moderationStatus == 'normal' || data.moderationStatus == 'reported' || data.moderationStatus == 'hidden') &&
      data.hiddenAt is string && data.hiddenAt.size() <= 40 &&
      data.hiddenBy is string && data.hiddenBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        'reportId', 'workspaceOwnerUid', 'classId', 'reporterUid', 'targetType',
        'targetId', 'targetPreview', 'reason', 'status', 'reviewedBy',
        'reviewedAt', 'reviewNote', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'reportId', 'workspaceOwnerUid', 'classId', 'reporterUid', 'targetType',
        'targetId', 'targetPreview', 'reason', 'status', 'reviewedBy',
        'reviewedAt', 'reviewNote', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.reportId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.classId) &&
      isValidId(data.reporterUid) &&
      data.targetType is string && (data.targetType == 'letter' || data.targetType == 'loungeMessage' || data.targetType == 'mission') &&
      isValidId(data.targetId) &&
      data.targetPreview is string && data.targetPreview.size() <= 300 &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
      data.status is string && (data.status == 'pending' || data.status == 'resolved' || data.status == 'dismissed') &&
      data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
      data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
      data.reviewNote is string && data.reviewNote.size() <= 240 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'logId', 'workspaceOwnerUid', 'actorUid', 'actorName', 'action',
        'targetType', 'targetId', 'reason', 'metadataSummary', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'logId', 'workspaceOwnerUid', 'actorUid', 'actorName', 'action',
        'targetType', 'targetId', 'reason', 'metadataSummary', 'createdAt'
      ]) &&
      isValidId(data.logId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      isValidId(data.actorUid) &&
      data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
      data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
      data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40 &&
      data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
      data.metadataSummary is string && data.metadataSummary.size() <= 400 &&
      data.createdAt is timestamp;
    }

    function isValidAppSetting(data) {
      return data.keys().hasAll([
        'settingId', 'workspaceOwnerUid', 'loungeRules', 'profilePolicy',
        'letterModerationPolicy', 'dataRetentionPolicy', 'identityRevealPolicy',
        'allowPhotoEvidence', 'updatedBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'settingId', 'workspaceOwnerUid', 'loungeRules', 'profilePolicy',
        'letterModerationPolicy', 'dataRetentionPolicy', 'identityRevealPolicy',
        'allowPhotoEvidence', 'updatedBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.settingId) &&
      isAuthorizedWorkspace(data.workspaceOwnerUid) &&
      data.loungeRules is string && data.loungeRules.size() <= 500 &&
      data.profilePolicy is string && data.profilePolicy.size() <= 500 &&
      data.letterModerationPolicy is string && data.letterModerationPolicy.size() <= 500 &&
      data.dataRetentionPolicy is string && data.dataRetentionPolicy.size() <= 500 &&
      data.identityRevealPolicy is string && (data.identityRevealPolicy == 'hidden' || data.identityRevealPolicy == 'revealed') &&
      data.allowPhotoEvidence is bool &&
      data.updatedBy is string && data.updatedBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection Match Blocks

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(adminId) && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(userId) && isValidUser(incoming()) && incoming().uid == userId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentLoginId', 'displayName', 'avatarId', 'bio', 'interests', 'hobbies',
          'favoriteFood', 'strengths', 'cheerWanted', 'profileVisibility',
          'passwordHash', 'accountStatus', 'lastLoginAt', 'lastHeartbeatAt',
          'isOnlineSession', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /classes/{classId} {
      allow get: if isValidId(classId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(classId) && isValidClassRoom(incoming()) && incoming().classId == classId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(classId) && isValidClassRoom(incoming()) &&
        incoming().classId == existing().classId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolName', 'teacherUids', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /manittoAssignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(assignmentId) && isValidManittoAssignment(incoming()) && incoming().assignmentId == assignmentId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(assignmentId) && isValidManittoAssignment(incoming()) &&
        incoming().assignmentId == existing().assignmentId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['giverUid', 'receiverUid', 'active', 'startsAt', 'endsAt', 'updatedAt']);
      allow delete: if isValidId(assignmentId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /missions/{missionId} {
      allow get: if isValidId(missionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(missionId) && isValidMission(incoming()) && incoming().missionId == missionId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(missionId) && isValidMission(incoming()) &&
        incoming().missionId == existing().missionId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'howTo', 'category', 'difficulty',
          'points', 'active', 'requiresTeacherApproval', 'allowRepeat',
          'maxCompletions', 'badgeRuleType', 'updatedAt'
        ]);
      allow delete: if isValidId(missionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /missionSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(submissionId) && isValidMissionSubmission(incoming()) && incoming().submissionId == submissionId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId) && isValidMissionSubmission(incoming()) &&
        incoming().submissionId == existing().submissionId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'actionDescription', 'reflection', 'activityDate', 'evidenceNote',
          'status', 'awardedPoints', 'reviewedBy', 'reviewedAt',
          'reviewComment', 'updatedAt'
        ]);
      allow delete: if isValidId(submissionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /scoreLedger/{ledgerId} {
      allow get: if isValidId(ledgerId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(ledgerId) && isValidScoreLedger(incoming()) && incoming().ledgerId == ledgerId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(ledgerId) && isValidScoreLedger(incoming()) &&
        incoming().ledgerId == existing().ledgerId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['reversalOf', 'updatedAt']);
      allow delete: if isValidId(ledgerId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /studentStats/{statId} {
      allow get: if isValidId(statId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(statId) && isValidStudentStats(incoming()) && incoming().studentUid == statId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(statId) && isValidStudentStats(incoming()) &&
        incoming().studentUid == existing().studentUid &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['totalPoints', 'completedMissionCount', 'earnedBadgeCount', 'updatedAt']);
      allow delete: if isValidId(statId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /badges/{badgeId} {
      allow get: if isValidId(badgeId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(badgeId) && isValidBadge(incoming()) && incoming().badgeId == badgeId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(badgeId) && isValidBadge(incoming()) &&
        incoming().badgeId == existing().badgeId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'criteria', 'targetCount', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /badgeAwards/{awardId} {
      allow get: if isValidId(awardId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(awardId) && isValidBadgeAward(incoming()) && incoming().awardId == awardId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(awardId) && isValidBadgeAward(incoming()) &&
        incoming().awardId == existing().awardId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['criteriaSnapshot', 'updatedAt']);
      allow delete: if isValidId(awardId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /letterThreads/{threadId} {
      allow get: if isValidId(threadId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(threadId) && isValidLetterThread(incoming()) && incoming().threadId == threadId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(threadId) && isValidLetterThread(incoming()) &&
        incoming().threadId == existing().threadId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'status', 'updatedAt']);
      allow delete: if isValidId(threadId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /letters/{letterId} {
      allow get: if isValidId(letterId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(letterId) && isValidLetter(incoming()) && incoming().letterId == letterId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(letterId) && isValidLetter(incoming()) &&
        incoming().letterId == existing().letterId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['readAt', 'moderationStatus', 'deletedAt', 'updatedAt']);
      allow delete: if isValidId(letterId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /loungeSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(sessionId) && isValidLoungeSession(incoming()) && incoming().sessionId == sessionId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(sessionId) && isValidLoungeSession(incoming()) &&
        incoming().sessionId == existing().sessionId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'noticeRules', 'scheduledDate', 'startsAt', 'endsAt',
          'status', 'waitingCount', 'participantCount', 'updatedAt'
        ]);
      allow delete: if isValidId(sessionId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);

      // Pillar 1 Master Gate Subcollection
      match /participants/{participantId} {
        allow get: if isValidId(sessionId) && isValidId(participantId) &&
          isAuthorizedWorkspace(get(/databases/$(database)/documents/loungeSessions/$(sessionId)).data.workspaceOwnerUid);
        allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
        allow create: if isValidId(sessionId) && isValidId(participantId) &&
          isValidLoungeParticipant(incoming()) &&
          incoming().participantUid == participantId &&
          incoming().sessionId == sessionId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isAuthorizedWorkspace(get(/databases/$(database)/documents/loungeSessions/$(sessionId)).data.workspaceOwnerUid);
        allow update: if isValidId(sessionId) && isValidId(participantId) &&
          isValidLoungeParticipant(incoming()) &&
          incoming().participantUid == existing().participantUid &&
          incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isAuthorizedWorkspace(get(/databases/$(database)/documents/loungeSessions/$(sessionId)).data.workspaceOwnerUid) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'anonymousAlias', 'presenceStatus', 'aliasChangeCount',
            'lastHeartbeatAt', 'aliasChangedAt', 'updatedAt'
          ]);
        allow delete: if isValidId(sessionId) && isValidId(participantId) &&
          isAuthorizedWorkspace(get(/databases/$(database)/documents/loungeSessions/$(sessionId)).data.workspaceOwnerUid);
      }
    }

    match /loungeMessages/{messageId} {
      allow get: if isValidId(messageId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(messageId) && isValidLoungeMessage(incoming()) && incoming().messageId == messageId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(messageId) && isValidLoungeMessage(incoming()) &&
        incoming().messageId == existing().messageId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'hiddenAt', 'hiddenBy', 'updatedAt']);
      allow delete: if isValidId(messageId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(reportId) && isValidReport(incoming()) && incoming().reportId == reportId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(reportId) && isValidReport(incoming()) &&
        incoming().reportId == existing().reportId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote', 'updatedAt']);
      allow delete: if isValidId(reportId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(logId) && isValidAuditLog(incoming()) && incoming().logId == logId && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /appSettings/{settingId} {
      allow get: if isValidId(settingId) && isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow list: if isAuthorizedWorkspace(existing().workspaceOwnerUid);
      allow create: if isValidId(settingId) && isValidAppSetting(incoming()) && incoming().settingId == settingId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isValidAppSetting(incoming()) &&
        incoming().settingId == existing().settingId &&
        incoming().workspaceOwnerUid == existing().workspaceOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedWorkspace(existing().workspaceOwnerUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'loungeRules', 'profilePolicy', 'letterModerationPolicy',
          'dataRetentionPolicy', 'identityRevealPolicy',
          'allowPhotoEvidence', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
